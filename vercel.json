{
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi",
  "crons": [
    {
      "path": "/api/push/cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/exchange-rates",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/connect-orphans",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/connect-settle-earnings",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/connect-scheduled",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/connect-recharge-expiry",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/broadcast-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/data-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/social-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/social-publish",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/social-stats",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/social-trends",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/auto-broadcast",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/social-health",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/voice-dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/outreach-mail",
      "schedule": "*/10 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
